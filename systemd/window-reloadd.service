# Reference copy. `window-reload install` writes this to
# ~/.config/systemd/user/window-reloadd.service with the correct absolute path.
[Unit]
Description=Record Hyprland window layout for window-reload
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Adjust the path to wherever you installed the binary.
ExecStart=%h/.cargo/bin/window-reloadd
# A Hyprland restart closes the event socket and the daemon exits cleanly; it
# re-resolves the new instance on restart, so always restart it.
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
